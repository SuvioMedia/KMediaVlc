{
  "schemaVersion": 1,
  "id": "videolan-vlc-windows-lgpl",
  "vlcRevision": "04d555a9d391f009d4f510f508fef58c39bdf810",
  "sourcePatches": ["build-recipes/patches/vlc-meson-core-library.patch"],
  "publicationTargets": ["windows-x86_64", "windows-aarch64"],
  "auditToolchainImage": "registry.videolan.org/vlc-debian-llvm-ucrt:20260611225331",
  "compiler": "LLVM-MinGW-UCRT",
  "libVlcCoreAbiMajor": 9,
  "wineUse": "Meson-cross-executable-sanity-only",
  "nativeValidationRunner": "windows-2022",
  "upstreamBuildScript": "extras/package/win32/build.sh",
  "libVlcBuildArguments": ["-r", "-u", "-z", "-g", "l", "-m", "-o", "/"],
  "contribBuildArguments": ["--disable-sout", "--enable-shout", "--disable-lua"],
  "mesonBuildArguments": ["-Dstream_outputs=false", "-Dvideolan_manager=false", "-Dlua=disabled"],
  "mesonInstallTags": ["runtime"],
  "mesonInstallPrefix": "/",
  "stripInstalledTargets": true,
  "usesPrebuiltContribs": false,
  "requiresPerFileInventory": true,
  "forbidsStockNightly": true
}
