diff --git a/modules/video_output/vgl.c b/modules/video_output/vgl.c
index ef2a85d..36518fd 100644
--- a/modules/video_output/vgl.c
+++ b/modules/video_output/vgl.c
@@ -50,8 +50,123 @@ typedef struct vout_display_sys_t
     void* opaque;
     unsigned width;
     unsigned height;
+    libvlc_video_render_cfg_t source_cfg;
 } vout_display_sys_t;
 
+static unsigned SourceBitdepth(const video_format_t *source)
+{
+    if (source == NULL)
+        return 8;
+
+    const vlc_chroma_description_t *desc =
+        vlc_fourcc_GetChromaDescription(source->i_chroma);
+    if (desc == NULL || desc->color_bits <= 0.0f)
+        return 8;
+
+    const unsigned bitdepth = (unsigned)(desc->color_bits + 0.5f);
+    return bitdepth != 0 ? bitdepth : 8;
+}
+
+static libvlc_video_color_space_t SourceColorspace(const video_format_t *source)
+{
+    if (source != NULL) {
+        switch (source->space) {
+            case COLOR_SPACE_BT601: return libvlc_video_colorspace_BT601;
+            case COLOR_SPACE_BT709: return libvlc_video_colorspace_BT709;
+            case COLOR_SPACE_BT2020: return libvlc_video_colorspace_BT2020;
+            case COLOR_SPACE_UNDEF: break;
+        }
+    }
+    return libvlc_video_colorspace_BT709;
+}
+
+static libvlc_video_color_primaries_t SourcePrimaries(const video_format_t *source)
+{
+    if (source != NULL) {
+        switch (source->primaries) {
+            case COLOR_PRIMARIES_BT601_525: return libvlc_video_primaries_BT601_525;
+            case COLOR_PRIMARIES_BT601_625: return libvlc_video_primaries_BT601_625;
+            case COLOR_PRIMARIES_BT709: return libvlc_video_primaries_BT709;
+            case COLOR_PRIMARIES_BT2020: return libvlc_video_primaries_BT2020;
+            case COLOR_PRIMARIES_DCI_P3: return libvlc_video_primaries_DCI_P3;
+            case COLOR_PRIMARIES_FCC1953: return libvlc_video_primaries_BT470_M;
+            case COLOR_PRIMARIES_UNDEF: break;
+        }
+    }
+    return libvlc_video_primaries_BT709;
+}
+
+static libvlc_video_transfer_func_t SourceTransfer(const video_format_t *source)
+{
+    if (source != NULL) {
+        switch (source->transfer) {
+            case TRANSFER_FUNC_LINEAR: return libvlc_video_transfer_func_LINEAR;
+            case TRANSFER_FUNC_SRGB: return libvlc_video_transfer_func_SRGB;
+            case TRANSFER_FUNC_BT470_BG: return libvlc_video_transfer_func_BT470_BG;
+            case TRANSFER_FUNC_BT470_M: return libvlc_video_transfer_func_BT470_M;
+            case TRANSFER_FUNC_BT709: return libvlc_video_transfer_func_BT709;
+            case TRANSFER_FUNC_SMPTE_ST2084: return libvlc_video_transfer_func_PQ;
+            case TRANSFER_FUNC_SMPTE_240: return libvlc_video_transfer_func_SMPTE_240;
+            case TRANSFER_FUNC_HLG: return libvlc_video_transfer_func_HLG;
+            case TRANSFER_FUNC_UNDEF: break;
+        }
+    }
+    return libvlc_video_transfer_func_SRGB;
+}
+
+static void SetSourceConfig(vout_display_sys_t *sys, const video_format_t *source)
+{
+    sys->source_cfg = (libvlc_video_render_cfg_t) {
+        .bitdepth = SourceBitdepth(source),
+        .full_range = source != NULL && source->color_range == COLOR_RANGE_FULL,
+        .colorspace = SourceColorspace(source),
+        .primaries = SourcePrimaries(source),
+        .transfer = SourceTransfer(source),
+        .device = NULL,
+    };
+}
+
+static bool OutputColorspace(libvlc_video_color_space_t colorspace,
+                             video_color_space_t *result)
+{
+    switch (colorspace) {
+        case libvlc_video_colorspace_BT601: *result = COLOR_SPACE_BT601; return true;
+        case libvlc_video_colorspace_BT709: *result = COLOR_SPACE_BT709; return true;
+        case libvlc_video_colorspace_BT2020: *result = COLOR_SPACE_BT2020; return true;
+    }
+    return false;
+}
+
+static bool OutputPrimaries(libvlc_video_color_primaries_t primaries,
+                            video_color_primaries_t *result)
+{
+    switch (primaries) {
+        case libvlc_video_primaries_BT601_525: *result = COLOR_PRIMARIES_BT601_525; return true;
+        case libvlc_video_primaries_BT601_625: *result = COLOR_PRIMARIES_BT601_625; return true;
+        case libvlc_video_primaries_BT709: *result = COLOR_PRIMARIES_BT709; return true;
+        case libvlc_video_primaries_BT2020: *result = COLOR_PRIMARIES_BT2020; return true;
+        case libvlc_video_primaries_DCI_P3: *result = COLOR_PRIMARIES_DCI_P3; return true;
+        case libvlc_video_primaries_BT470_M: *result = COLOR_PRIMARIES_FCC1953; return true;
+    }
+    return false;
+}
+
+static bool OutputTransfer(libvlc_video_transfer_func_t transfer,
+                           video_transfer_func_t *result)
+{
+    switch (transfer) {
+        case libvlc_video_transfer_func_LINEAR: *result = TRANSFER_FUNC_LINEAR; return true;
+        case libvlc_video_transfer_func_SRGB: *result = TRANSFER_FUNC_SRGB; return true;
+        case libvlc_video_transfer_func_BT470_BG: *result = TRANSFER_FUNC_BT470_BG; return true;
+        case libvlc_video_transfer_func_BT470_M: *result = TRANSFER_FUNC_BT470_M; return true;
+        case libvlc_video_transfer_func_BT709: *result = TRANSFER_FUNC_BT709; return true;
+        case libvlc_video_transfer_func_PQ: *result = TRANSFER_FUNC_SMPTE_ST2084; return true;
+        case libvlc_video_transfer_func_SMPTE_240: *result = TRANSFER_FUNC_SMPTE_240; return true;
+        case libvlc_video_transfer_func_HLG: *result = TRANSFER_FUNC_HLG; return true;
+    }
+    return false;
+}
+
 
