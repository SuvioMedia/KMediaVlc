From: KMediaVlc build policy <noreply@localhost>
Subject: [PATCH] Make the Android static module set deterministic and LGPL-only

The upstream Android build is also used by GPL applications and its broad
blacklist does not exclude every VLC module that declares GPL-2.0-or-later.
KMediaVlc links the modules into a library used by its LGPL bridge, so
reject those modules before the final libvlc.so link and sort the input list.

The Android runtime does not expose optical Blu-ray disc playback. Disable its
contrib and VLC module instead of building the host-only BD-J Java payload.
Use a portable in-place sed invocation so the same source recipe works on GNU
and BSD hosts. Fix the literal archive-name lookup and allow pkg-config to
return both upstream protobuf variants when generating the static link line.
Exclude the newly automatic libnoidea/NDI graph from this closed Android recipe.

--- a/buildsystem/build-libvlc.sh
+++ b/buildsystem/build-libvlc.sh
@@ -227,7 +227,7 @@
 
 avlc_find_modules()
 {
-    echo "$(find $1 -name 'lib*plugin.a' | grep -vE "lib(${blacklist_regexp})_plugin.a" | tr '\n' ' ')"
+    echo "$(find $1 -name 'lib*plugin.a' | grep -vE "lib(${blacklist_regexp})_plugin.a" | LC_ALL=C sort | tr '\n' ' ')"
 }
 
 avlc_get_symbol()
@@ -275,6 +275,8 @@
 VLC_CONTRIB_ARGS="\
     --disable-aribb24 \
     --disable-aribb25 \
+    --disable-bluray \
+    --disable-libnoidea \
     --disable-caca \
     --disable-chromaprint \
     --disable-faad2 \
@@ -352,7 +354,8 @@
     --disable-xcb \
     --enable-avcodec \
     --enable-avformat \
-    --enable-bluray \
+    --disable-bluray \
+    --disable-ndi \
     --enable-chromecast \
     --enable-dvbpsi \
     --enable-fluidlite \
@@ -385,6 +388,30 @@
     addons.*
     alphamask
     aout_file
+    avahi
+    dbus
+    dummy
+    file_logger
+    lirc
+    lua
+    macosx
+    mtp
+    ncurses
+    notify
+    ntservice
+    osx_notifications
+    qt
+    rc
+    rotate
+    skins2
+    stream_out_(cycle|rtp)
+    syslog
+    win_hotkeys
+    win_msg
+    x264
+    x26410b
+    x265
+    xcb_hotkeys
     audiobargraph_[av]
     audioscrobbler
     ball
@@ -555,7 +582,8 @@
 # disable forced -lc++ in contribs
 PC_FILES=$(find ${VLC_CONTRIB_OUT_DIR}/lib/pkgconfig -type f -name '*.pc')
 for pcfile in ${PC_FILES}; do
-    sed -i 's/ -lc++//' $pcfile
+    sed -i.bak 's/ -lc++//' "$pcfile"
+    rm -f "$pcfile.bak"
 done
 
 mkdir -p $VLC_BUILD_DIR
@@ -640,7 +668,7 @@
 
 # find and return the path of $2 inside $1
 avlc_find_lib() {
-    find $1 -name '$2'
+    find "$1" -name "$2"
 }
 
 # get all global symbols of a library and add them to SYMBOLS_TO_REDIFINE list
@@ -711,7 +739,7 @@
 ###########################
 
 VLC_MODULES=$(avlc_find_modules ${REDEFINED_VLC_MODULES_DIR})
-VLC_CONTRIB_LDFLAGS=$(cd $VLC_CONTRIB/lib/pkgconfig; avlc_pkgconfig --libs $(ls *.pc  | sed -e 's/\.pc$//' | xargs))
+VLC_CONTRIB_LDFLAGS=$(cd $VLC_CONTRIB/lib/pkgconfig; PKG_CONFIG_IGNORE_CONFLICTS=1 avlc_pkgconfig --libs $(ls *.pc  | sed -e 's/\.pc$//' | xargs))
 
 if [ "$AVLC_STATIC_CXX" = 1 ]; then
     VLC_APP_STL="c++_static"
@@ -724,6 +752,7 @@
 $NDK_BUILD -C $LIBVLCJNI_ROOT/libvlc \
     APP_STL="$VLC_APP_STL" \
     APP_CPPFLAGS="-frtti -fexceptions" \
+    APP_LDFLAGS="${APP_LDFLAGS}" \
     VLC_SRC_DIR="$VLC_SRC_DIR" \
     VLC_BUILD_DIR="$VLC_BUILD_DIR" \
     VLC_CONTRIB="$VLC_CONTRIB" \
