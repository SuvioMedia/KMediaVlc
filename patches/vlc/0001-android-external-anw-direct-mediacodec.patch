From: KMediaVlc Android maintainers <noreply@localhost>
Subject: [PATCH] android: preserve external ANW color and exact frame timing

Keep externally supplied ANativeWindows on the direct MediaCodec path so their
per-buffer color information survives. The optional, versioned KMedia callback
reports the actual decoded PTS and the exact timestamp passed to timed MediaCodec
release. It runs before that release, so a SurfaceTexture consumer can look up
the acquired buffer without estimating media position from a system clock.

The caller installs the callback before opening media, supplies an immutable
source generation, and keeps its opaque data alive until player teardown.
Untimed/software output intentionally supplies no timing proof. This is a
private source-built extension; older libVLC runtimes have no matching symbol.

---
diff --git a/include/vlc/libvlc_media_player.h b/include/vlc/libvlc_media_player.h
index 9cef608..2055614 100644
--- a/include/vlc/libvlc_media_player.h
+++ b/include/vlc/libvlc_media_player.h
@@ -1421,6 +1421,14 @@ libvlc_video_set_anw_callbacks( libvlc_media_player_t *mp,
                                               NULL, NULL, NULL, opaque );
 }
 
+/** KMediaVlc v1 extension: decoded PTS and its exact timed MediaCodec Surface key.
+ * Install before opening media. The callback must not reenter libVLC; its opaque
+ * value must outlive the player. Untimed/software outputs do not invoke it.
+ */
+typedef void (*libvlc_kmedia_anw_frame_cb)(void *, uint64_t, int64_t, int64_t);
+LIBVLC_API bool libvlc_kmedia_set_anw_frame_callback_v1(
+    libvlc_media_player_t *, libvlc_kmedia_anw_frame_cb, void *, uint64_t);
+
 /**
  * Set the handler where the media player should display its video output.
  *
diff --git a/lib/libvlc.sym b/lib/libvlc.sym
index daadc8f..504704a 100644
--- a/lib/libvlc.sym
+++ b/lib/libvlc.sym
@@ -261,6 +261,7 @@ libvlc_video_set_deinterlace
 libvlc_video_set_format
 libvlc_video_set_format_callbacks
 libvlc_video_set_output_callbacks
+libvlc_kmedia_set_anw_frame_callback_v1
 libvlc_video_set_key_input
 libvlc_video_set_logo_int
 libvlc_video_set_logo_string
diff --git a/lib/media_player.c b/lib/media_player.c
index 64af8b1..d685163 100644
--- a/lib/media_player.c
+++ b/lib/media_player.c
@@ -1191,6 +1191,21 @@ static void libvlc_media_player_detach_output_callbacks(libvlc_media_player_t *p
     var_SetAddress(player, "vout-cb-select-plane", NULL);
 }
 
+bool libvlc_kmedia_set_anw_frame_callback_v1(libvlc_media_player_t *mp,
+    libvlc_kmedia_anw_frame_cb callback, void *opaque, uint64_t generation)
+{
+    if (mp == NULL || generation > INT64_MAX)
+        return false;
+    if (var_Create(mp, "kmedia-anw-frame-cb", VLC_VAR_ADDRESS) != VLC_SUCCESS ||
+        var_Create(mp, "kmedia-anw-frame-opaque", VLC_VAR_ADDRESS) != VLC_SUCCESS ||
+        var_Create(mp, "kmedia-anw-frame-generation", VLC_VAR_INTEGER) != VLC_SUCCESS)
+        return false;
+    var_SetAddress(mp, "kmedia-anw-frame-cb", callback);
+    var_SetAddress(mp, "kmedia-anw-frame-opaque", opaque);
+    var_SetInteger(mp, "kmedia-anw-frame-generation", generation);
+    return true;
+}
+
 bool libvlc_video_set_output_callbacks(libvlc_media_player_t *mp,
                                        libvlc_video_engine_t engine,
                                        libvlc_video_output_setup_cb setup_cb,
diff --git a/modules/video_output/android/display.c b/modules/video_output/android/display.c
index ca50379..1f2921a 100644
--- a/modules/video_output/android/display.c
+++ b/modules/video_output/android/display.c
@@ -125,6 +125,9 @@ struct subpicture
 struct sys
 {
     AWindowHandler *awh;
+    void (*frame_cb)(void *, uint64_t, int64_t, int64_t);
+    void *frame_opaque;
+    uint64_t frame_generation;
     bool can_set_video_layout;
     android_video_context_t *avctx;
     struct subpicture sub;
@@ -520,7 +523,16 @@ static void Prepare(vout_display_t *vd, picture_t *picture,
     assert(picture->context);
     assert(sys->asc.sc == NULL);
     if (sys->avctx->render_ts != NULL)
+    {
+        /* Record before releasing the decoder buffer: its Surface consumer can
+         * acquire it immediately. Repeated redraws keep the same producer key.
+         * date is a system clock value; picture->date is the decoded media PTS. */
+        if (sys->frame_cb != NULL && picture->date != VLC_TICK_INVALID &&
+            date > 0 && date <= INT64_MAX / 1000)
+            sys->frame_cb(sys->frame_opaque, sys->frame_generation,
+                US_FROM_VLC_TICK(picture->date - VLC_TICK_0), NS_FROM_VLC_TICK(date));
         sys->avctx->render_ts(picture->context, date);
+    }
 
     if (sys->sub.window != NULL)
         subpicture_Prepare(vd, subpicture);
@@ -712,6 +724,9 @@ static int Open(vout_display_t *vd,
         return VLC_ENOMEM;
 
     sys->awh = awh;
+    sys->frame_cb = var_InheritAddress(vd, "kmedia-anw-frame-cb");
+    sys->frame_opaque = var_InheritAddress(vd, "kmedia-anw-frame-opaque");
+    sys->frame_generation = var_InheritInteger(vd, "kmedia-anw-frame-generation");
     sys->can_set_video_layout = can_set_video_layout;
     sys->asc.sc = NULL;
     sys->avctx = vlc_video_context_GetPrivate(context, VLC_VIDEO_CONTEXT_AWINDOW);
diff --git a/modules/video_output/android/utils.c b/modules/video_output/android/utils.c
index ef277c1..ace5400 100644
--- a/modules/video_output/android/utils.c
+++ b/modules/video_output/android/utils.c
@@ -768,6 +768,11 @@ AWindowHandler_newFromANWs(vlc_object_t *obj, ANativeWindow *video,
     awh->wnd = NULL;
 
     LoadNativeWindowAPI(awh);
+    /* Externally supplied ANativeWindows are already the final video target.
+     * Keep MediaCodec on that target instead of inserting an AImageReader and
+     * ASurfaceControl layer, which can discard per-buffer HDR dataspaces. */
+    awh->b_has_ndk_air_api = false;
+    awh->b_has_ndk_asc_api = false;
 
     awh->views[AWindow_Video].p_anw = video;
     ANativeWindow_acquire(video);
